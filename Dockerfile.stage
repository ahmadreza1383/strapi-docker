FROM node:22-alpine

RUN apk add --no-cache \
  build-base \
  python3 \
  autoconf \
  automake \
  zlib-dev \
  libpng-dev \
  vips-dev \
  git

WORKDIR /opt/app

# Copy package files from build-context (strapi-cache)
# For "latest": strapi-cache contains fresh Strapi package files
# For cached versions: strapi-cache points directly to releases/<version>/
COPY --from=strapi-cache package.json package-lock.json ./
COPY requirements.txt ./

ENV NODE_ENV=production

RUN npm config set fetch-retry-maxtimeout 600000 -g \
 && npm ci --omit=dev \
 && npm install $(cat requirements.txt)

ENV PATH=/opt/app/node_modules/.bin:$PATH
